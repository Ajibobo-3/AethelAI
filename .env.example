# Copy these values into Vercel Project Settings → Environment Variables.
# Never commit real credentials or share them in chat.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
GROQ_API_KEY=YOUR_GROQ_API_KEY
AETHEL_ADMIN_KEY=GENERATE_A_LONG_RANDOM_SECRET
AETHEL_ALLOWED_MODELS=llama-3.1-8b-instant
AETHEL_DAILY_REQUEST_LIMIT=100
AETHEL_MAX_DAILY_REQUEST_LIMIT=10000
AETHEL_MAX_OUTPUT_TOKENS=2048
# Agent fallback model is fixed in the gateway: llama-3.3-70b-versatile.
# Optional: map other public model IDs to Groq models. Standard aliases are pinned in code.
# AETHEL_GROQ_MODEL_MAP='{"my-public-model":"llama-3.1-8b-instant"}'
