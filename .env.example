# Copy these values into Vercel Project Settings → Environment Variables.
# Never commit real credentials or share them in chat.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
OPENAI_API_KEY=YOUR_PROVIDER_API_KEY
AETHEL_ADMIN_KEY=GENERATE_A_LONG_RANDOM_SECRET
AETHEL_ALLOWED_MODELS=gpt-4o-mini
AETHEL_DAILY_REQUEST_LIMIT=100
AETHEL_MAX_OUTPUT_TOKENS=2048
# Optional: an OpenAI-compatible API base URL.
# OPENAI_BASE_URL=https://api.openai.com/v1
